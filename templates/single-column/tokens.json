{
  "$description": "Single-column template tokens (W3C Design Tokens 2025.10). Layout lives in the template; everything visual lives here (D-013). Sizes are multipliers of a base size, so one scale serves print (9.5pt base) and mobile (16px base).",
  "color": {
    "$type": "color",
    "ink": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.114,
          0.133,
          0.161
        ],
        "alpha": 1,
        "hex": "#1d2229"
      },
      "$description": "Portfolio ink"
    },
    "slate": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.294,
          0.333,
          0.388
        ],
        "alpha": 1,
        "hex": "#4b5563"
      },
      "$description": "Portfolio line-on-paper; 7.6:1 on white"
    },
    "raspberry": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.769,
          0,
          0.361
        ],
        "alpha": 1,
        "hex": "#c4005c"
      },
      "$description": "Portfolio accent; 5.9:1 on white"
    },
    "paper": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.941,
          0.953,
          0.965
        ],
        "alpha": 1,
        "hex": "#f0f3f6"
      },
      "$description": "Portfolio paper"
    },
    "white": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          1,
          1,
          1
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "mist": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.804,
          0.827,
          0.855
        ],
        "alpha": 1,
        "hex": "#cdd3da"
      }
    },
    "text": {
      "default": {
        "$value": "{color.ink}"
      },
      "muted": {
        "$value": "{color.slate}"
      },
      "accent": {
        "$value": "{color.raspberry}"
      }
    },
    "surface": {
      "page": {
        "$value": "{color.white}",
        "$description": "The sheet; always white so print and PDF use no ink for background"
      },
      "canvas": {
        "$value": "{color.paper}",
        "$description": "Behind the sheet on screen"
      }
    },
    "rule": {
      "$value": "{color.mist}"
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Archivo Black",
          "Arial Black",
          "sans-serif"
        ]
      },
      "body": {
        "$value": [
          "Archivo",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ]
      },
      "mono": {
        "$value": [
          "Space Mono",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Dates only. Space Mono is split into one PDF text item per word, so it must not carry anything a parser needs to read as a unit (headings, contact details) (D-048)"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "base": {
      "$type": "dimension",
      "print": {
        "$value": {
          "value": 12.667,
          "unit": "px"
        },
        "$description": "9.5pt. Also used for the on-screen sheet, so it matches print"
      },
      "flow": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "Phone-width reading size"
      }
    },
    "scale": {
      "$type": "number",
      "name": {
        "$value": 2.6
      },
      "headline": {
        "$value": 1.1
      },
      "section": {
        "$value": 0.8
      },
      "company": {
        "$value": 1.18
      },
      "title": {
        "$value": 1.03
      },
      "body": {
        "$value": 1
      },
      "meta": {
        "$value": 0.82
      },
      "description": {
        "$value": 0.92
      }
    },
    "leading": {
      "$type": "number",
      "tight": {
        "$value": 1.15
      },
      "body": {
        "$value": 1.45
      }
    },
    "tracking": {
      "$type": "number",
      "section": {
        "$value": 0,
        "$description": "em. Keep at 0: any letter spacing makes PDF text extractors read headings as separate letters (\"E X P E R I E N C E\"), which hides them from parsers (D-045)"
      },
      "name": {
        "$value": -0.01
      }
    }
  },
  "space": {
    "$type": "number",
    "$description": "Multipliers of the current font size (em)",
    "section": {
      "$value": 2.0
    },
    "section-head": {
      "$value": 0.7
    },
    "job": {
      "$value": 1.35
    },
    "position": {
      "$value": 0.8
    },
    "bullet": {
      "$value": 0.3
    },
    "bullet-indent": {
      "$value": 1.1
    }
  },
  "page": {
    "$type": "dimension",
    "margin-block": {
      "$value": {
        "value": 58,
        "unit": "px"
      },
      "$description": "≈0.6in"
    },
    "margin-inline": {
      "$value": {
        "value": 62,
        "unit": "px"
      },
      "$description": "≈0.65in"
    },
    "width": {
      "$value": {
        "value": 816,
        "unit": "px"
      },
      "$description": "8.5in"
    },
    "height": {
      "$value": {
        "value": 1056,
        "unit": "px"
      },
      "$description": "11in"
    }
  }
}
