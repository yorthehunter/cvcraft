{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cvcraft.local/schemas/library.schema.json",
  "title": "CVCraft library",
  "description": "The master library: every piece of resume content, written once. Variants pick from it. Field names follow JSON Resume (jsonresume.org/schema) where they fit (D-009).",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "basics", "work"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "basics": { "$ref": "#/$defs/basics" },
    "summaries": {
      "description": "Paragraph blocks such as a summary or mission statement. A variant picks one and gives it a heading.",
      "type": "array",
      "items": { "$ref": "#/$defs/summary" }
    },
    "work": {
      "description": "Employers, most recent first. Each has one or more positions.",
      "type": "array",
      "items": { "$ref": "#/$defs/work" }
    },
    "education": { "type": "array", "items": { "$ref": "#/$defs/education" } },
    "skills": {
      "description": "Named skill groups, rendered as 'Name: keyword, keyword'.",
      "type": "array",
      "items": { "$ref": "#/$defs/skill" }
    },
    "tools": {
      "description": "Groups of tools. Groups render separated by bullets; tools within a group by commas.",
      "type": "array",
      "items": { "$ref": "#/$defs/toolGroup" }
    },
    "development": {
      "description": "Courses and professional development.",
      "type": "array",
      "items": { "$ref": "#/$defs/course" }
    }
  },
  "$defs": {
    "id": {
      "description": "Stable identifier. Variants refer to items by id, so never reuse or rename one casually.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "date": {
      "description": "Year (2023) or year and month (2024-12). Shown at the precision given.",
      "type": "string",
      "pattern": "^\\d{4}(-(0[1-9]|1[0-2]))?$"
    },
    "text": { "type": "string", "minLength": 1 },
    "basics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "label", "email"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "label": { "description": "Default headline under the name. Variants may override it.", "$ref": "#/$defs/text" },
        "email": { "type": "string", "format": "email" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["city", "region"],
          "properties": {
            "city": { "$ref": "#/$defs/text" },
            "region": { "$ref": "#/$defs/text" }
          }
        },
        "profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "network", "url"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "network": { "description": "e.g. LinkedIn, Portfolio", "$ref": "#/$defs/text" },
              "label": { "description": "Link text; defaults to the network name.", "$ref": "#/$defs/text" },
              "url": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "paragraphs"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "paragraphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "highlight": {
      "description": "One bullet.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "$ref": "#/$defs/text" },
        "tags": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "startDate"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "position": { "description": "Job title.", "$ref": "#/$defs/text" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "description": "Omit for a current role.", "$ref": "#/$defs/date" },
        "summary": { "description": "Optional sentence under the title, before the bullets.", "$ref": "#/$defs/text" },
        "highlights": { "type": "array", "items": { "$ref": "#/$defs/highlight" } }
      }
    },
    "work": {
      "description": "An employer. Differs from JSON Resume, which repeats the company for each position; nesting keeps multi-role tenures (e.g. 8 years, 4 titles) together (D-027).",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "startDate", "positions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "description": "Company name as displayed.", "$ref": "#/$defs/text" },
        "description": { "description": "One line about the company.", "$ref": "#/$defs/text" },
        "url": { "type": "string", "format": "uri" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "description": "Omit if current.", "$ref": "#/$defs/date" },
        "positions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/position" } }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "institution", "studyType", "area"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "institution": { "$ref": "#/$defs/text" },
        "studyType": { "description": "e.g. MS, BA", "$ref": "#/$defs/text" },
        "area": { "description": "Field of study.", "$ref": "#/$defs/text" },
        "startDate": { "$ref": "#/$defs/date" },
        "endDate": { "$ref": "#/$defs/date" }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "keywords"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "keywords": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "toolGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keywords"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "description": "Optional group label, not shown in the pilot template.", "$ref": "#/$defs/text" },
        "keywords": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/text" } }
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "issuer"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "$ref": "#/$defs/text" },
        "issuer": { "description": "Who offers it, e.g. Maven.", "$ref": "#/$defs/text" },
        "instructor": { "$ref": "#/$defs/text" },
        "date": { "$ref": "#/$defs/date" },
        "url": { "type": "string", "format": "uri" }
      }
    }
  }
}
